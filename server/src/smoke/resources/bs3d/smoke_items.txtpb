# 验收夹具：通过 fabric.mod.json 的 bs3d:item_registries 自动发现，覆盖启动期 protobuf 注册。
version: 1
items {
  id: "bs3d_smoke:segmented_wearable"
  wearable {
    title: "分段穿戴夹具"
    model: "bs3d_smoke:segmented_wearable"
    slots { layer: "cape" bone: "chest" segment: "body" }
    slots { layer: "cape" bone: "head" segment: "strap" }
    asset { file: "models/LidPouch.bbmodel" mode: MODEL_RENDER_MODE_RAW_SEGMENTS }
  }
}
items {
  id: "bs3d_smoke:end_seed"
  description_translation_key: "item.bs3d_smoke.end_seed.description"
  creative_tab: "minecraft:natural"
  optional_fields { id: "bs3d_weights:weight" json: '{"grams": 3}' }
  plain { max_count: 16 }
}

# 自带模型：带开合动画的测试夹具在构建时复制到清单目录，客户端资源验收确认已加载。
items {
  id: "bs3d_smoke:bundled_pouch"
  container {
    title: "附属带盖袋"
    model: "bs3d_smoke:bundled_pouch"
    inside { width: 1 height: 2 depth: 2 }
    outside { width: 2 height: 2 depth: 2 }
    mounts: WAIST_RIGHT_FRONT
    asset {
      file: "models/LidPouch.bbmodel"
      open_animation: "open"
      close_animation: "close"
    }
  }
}

# 胸前、背后两用的验收背篓：Bong 九件没有能前后切换的胸背容器。几何同 2026-11-01 移除的旧背篓，
# 单位为格；模型用带开合动画的测试夹具，构建时与带盖袋一同复制。
items {
  id: "bs3d_smoke:lid_basket"
  container {
    title: "验收背篓"
    model: "bs3d_smoke:lid_basket"
    inside { width: 3 height: 3 depth: 3 }
    outside { width: 3 height: 3 depth: 4 }
    mounts: TORSO_FRONT
    mounts: TORSO_BACK
    asset {
      file: "models/LidBasket.bbmodel"
      open_animation: "open"
      close_animation: "close"
    }
  }
}
