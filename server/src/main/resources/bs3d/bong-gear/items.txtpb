    mounts: WAIST_RIGHT_FRONT
    mounts: WAIST_LEFT_FRONT
    mounts: WAIST_LEFT_BACK
    mounts: WAIST_RIGHT_BACK
    asset { file: "models/OreSack.bbmodel" }
  }
}

