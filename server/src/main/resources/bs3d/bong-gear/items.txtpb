# 从 Bong 导入的收纳装备；容量单位为格。修改后客户端和服务端须同时更新。
version: 1

items {
  id: "bs3d:gu_jia_bei_lou"
  description_translation_key: "item.bs3d.gu_jia_bei_lou.description"
  container {
    title: "骨架背篓"
    model: "bs3d:gu_jia_bei_lou"
    inside { width: 3 height: 4 depth: 3 }
    outside { width: 3 height: 4 depth: 3 }
    mounts: TORSO_BACK
    asset { file: "models/GuJiaBeiLou.bbmodel" }
  }
}

items {
  id: "bs3d:xiu_kuang_bei_jia"
  description_translation_key: "item.bs3d.xiu_kuang_bei_jia.description"
  container {
    title: "锈框背架"
    model: "bs3d:xiu_kuang_bei_jia"
    inside { width: 4 height: 4 depth: 2 }
    outside { width: 4 height: 4 depth: 3 }
    mounts: TORSO_BACK
    asset { file: "models/XiuKuangBeiJia.bbmodel" }
  }
}

items {
  id: "bs3d:za_pi_xing_nang"
