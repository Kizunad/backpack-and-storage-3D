{
  "schemaVersion": 1,
  "id": "backpack_storage_3d",
  "version": "${version}",
  "name": "Backpack and Storage 3D Server",
  "description": "Stores the contents of wearable bags and lets players put them down or carry them.\n保存随身容器里装的物品，背包可以穿戴，也可以放在地上。",
  "contact": {
    "homepage": "https://github.com/Kizunad/backpack-and-storage-3D",
    "sources": "https://github.com/Kizunad/backpack-and-storage-3D",
    "issues": "https://github.com/Kizunad/backpack-and-storage-3D/issues"
  },
  "icon": "assets/backpack_storage_3d/icon.png",
  "environment": "*",
  "authors": [
    "Kizunad"
  ],
  "license": "MIT",
  "custom": {
    "bs3d:item_registries": ["bs3d/bong-gear/items.txtpb"]
  },
  "entrypoints": {
    "main": [
      "dev.kizuna.backpack3d.item.ContainerItems",
      "dev.kizuna.backpack3d.server.VolumeServer"
    ],
    "kizuna_inventory_ui_server": [
      "dev.kizuna.backpack3d.server.VolumeServer"
    ]
  },
  "mixins": [
    "bs3d.mixins.json"
  ],
  "depends": {
    "java": ">=25",
    "minecraft": "26.2",
    "fabricloader": ">=0.20.1",
    "fabric-api": ">=0.161.0+26.2",
    "kizuna_inventory_ui_server": "0.1.0"
  }
}
